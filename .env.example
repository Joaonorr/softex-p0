# Copie este arquivo para .env e ajuste os valores. Nunca versione o arquivo .env.

# Endereço do servidor Ollama local.
LLM_BASE_URL=http://localhost:11434

# Modelo instalado no Ollama (ollama pull qwen2.5:7b-instruct).
LLM_MODEL=qwen2.5:7b-instruct

# Token enviado no cabeçalho Authorization: Bearer.
# O Ollama local não valida token por padrão; o valor é obrigatório para o app
# e deve ser trocado se o endpoint estiver atrás de um gateway autenticado.
LLM_API_KEY=troque-por-um-token

# Tempo máximo de espera por resposta do LLM, em segundos.
LLM_TIMEOUT_SECONDS=30
